<div class="research-story">
  {% for paragraph in entry.contents.paragraphs %}
    {% assign paragraph_prefix = paragraph | strip | slice: 0, 8 %}
    <p{% if paragraph_prefix == '<strong>' %} class="research-story-detail"{% endif %}>{{ paragraph }}</p>
  {% endfor %}

  <div class="research-diagram" aria-label="Research story diagram">
    {% assign arch_class = entry.contents.diagram.classes[0] %}
    {% assign synth_class = entry.contents.diagram.classes[1] %}
    {% assign llm_class = entry.contents.diagram.classes[2] %}
    {% assign compact_diagram = entry.contents.diagram.compact | default: false %}
    {% if compact_diagram %}
      {% assign diagram_height = 360 %}
      {% assign group_height = 255 %}
      {% assign class_y = 138 %}
      {% assign class_height = 200 %}
      {% assign class_title_y = 166 %}
      {% assign class_body_y = 194 %}
    {% else %}
      {% assign diagram_height = 415 %}
      {% assign group_height = 310 %}
      {% assign class_y = 138 %}
      {% assign class_height = 255 %}
      {% assign class_title_y = 168 %}
      {% assign class_body_y = 200 %}
    {% endif %}
    <svg class="research-diagram-svg" viewBox="0 0 1200 {{ diagram_height }}" role="img">

      <g class="research-svg-current-band">
        <rect x="30" y="15" width="1140" height="72" rx="4"></rect>
        <text class="research-svg-current-title research-svg-green-text" x="600" y="42">{{ entry.contents.diagram.current_work.title }}</text>
        {% assign current_item_count = entry.contents.diagram.current_work.items.size %}
        {% assign current_item_step = 1140 | divided_by: current_item_count %}
        {% assign current_item_half_step = current_item_step | divided_by: 2 %}
        {% for item in entry.contents.diagram.current_work.items %}
          {% assign item_x = forloop.index0 | times: current_item_step | plus: current_item_half_step | plus: 30 %}
          <text class="research-svg-current-item" x="{{ item_x }}" y="70">{{ item }}</text>
          {% unless forloop.last %}
            {% assign divider_x = forloop.index | times: current_item_step | plus: 30 %}
            <path class="research-svg-current-divider" d="M{{ divider_x }} 51 V77"></path>
          {% endunless %}
        {% endfor %}
      </g>

      <g class="research-svg-research-group">
        <rect x="20" y="100" width="1160" height="{{ group_height }}" rx="5"></rect>
        <text class="research-svg-region-label" x="600" y="126">{% if page.lang contains 'zh' %}科研工作{% else %}Research work{% endif %}</text>
      </g>

      {% for research_class in entry.contents.diagram.classes %}
        {% case forloop.index0 %}
          {% when 0 %}
            {% assign class_x = 40 %}
            {% assign class_mid = 215 %}
            {% if compact_diagram %}
              {% assign work_start = 262 %}
              {% assign work_step = 18 %}
            {% else %}
              {% assign work_start = 282 %}
              {% assign work_step = 21 %}
            {% endif %}
          {% when 1 %}
            {% assign class_x = 425 %}
            {% assign class_mid = 600 %}
            {% if compact_diagram %}
              {% assign work_start = 244 %}
              {% assign work_step = 18 %}
            {% else %}
              {% assign work_start = 262 %}
              {% assign work_step = 21 %}
            {% endif %}
          {% when 2 %}
            {% assign class_x = 810 %}
            {% assign class_mid = 985 %}
            {% if compact_diagram %}
              {% assign work_start = 254 %}
              {% assign work_step = 18 %}
            {% else %}
              {% assign work_start = 270 %}
              {% assign work_step = 21 %}
            {% endif %}
        {% endcase %}
        <g class="research-svg-class">
          <rect x="{{ class_x }}" y="{{ class_y }}" width="350" height="{{ class_height }}" rx="4"></rect>
          <text class="research-svg-title" x="{{ class_mid }}" y="{{ class_title_y }}">{{ research_class.title }}</text>
          <text class="research-svg-body" x="{{ class_x | plus: 24 }}" y="{{ class_body_y }}">
            {% for line in research_class.summary_lines %}
              <tspan x="{{ class_x | plus: 24 }}" dy="{% if forloop.first %}0{% else %}20{% endif %}">{{ line }}</tspan>
            {% endfor %}
          </text>
          {% for work in research_class.works %}
            {% assign work_y = forloop.index0 | times: work_step | plus: work_start %}
            <text class="research-svg-work" x="{{ class_x | plus: 24 }}" y="{{ work_y }}">
              <tspan class="research-svg-work-name">{{ work.name }}</tspan>{% if work.tag != "" %}<tspan> (</tspan>{% if work.link != "" %}<a href="{{ work.link }}"><tspan class="research-svg-work-tag">{{ work.tag }}</tspan></a>{% else %}<tspan>{{ work.tag }}</tspan>{% endif %}<tspan>)</tspan>{% endif %}
            </text>
          {% endfor %}
        </g>
      {% endfor %}

    </svg>
  </div>
</div>
