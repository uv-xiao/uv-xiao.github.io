<div class="research-story">
  {% for paragraph in entry.contents.paragraphs %}
    <p>{{ paragraph }}</p>
  {% endfor %}

  <div class="research-diagram" aria-label="Research story diagram">
    {% assign arch_class = entry.contents.diagram.classes[0] %}
    {% assign synth_class = entry.contents.diagram.classes[1] %}
    {% assign llm_class = entry.contents.diagram.classes[2] %}
    {% assign arch_to_synth = entry.contents.diagram.relationships[0] %}
    {% assign synth_to_arch = entry.contents.diagram.relationships[1] %}
    {% assign synth_to_llm = entry.contents.diagram.relationships[2] %}
    {% assign llm_to_arch = entry.contents.diagram.relationships[3] %}
    {% assign llm_to_synth = entry.contents.diagram.relationships[4] %}

    <svg class="research-diagram-svg" viewBox="0 0 1200 470" role="img">
      <defs>
        <marker id="research-arrow-blue" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L8,4 L0,8 Z" class="research-svg-arrow-head research-svg-blue-fill"></path>
        </marker>
        <marker id="research-arrow-green" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L8,4 L0,8 Z" class="research-svg-arrow-head research-svg-green-fill"></path>
        </marker>
      </defs>

      <g class="research-svg-class">
        <rect x="30" y="104" width="280" height="260" rx="4"></rect>
        <text class="research-svg-title" x="170" y="144">{{ arch_class.title }}</text>
        <text class="research-svg-body" x="54" y="174">
          {% for line in arch_class.summary_lines %}
            <tspan x="54" dy="{% if forloop.first %}0{% else %}20{% endif %}">{{ line }}</tspan>
          {% endfor %}
        </text>
        {% for work in arch_class.works %}
          {% assign work_y = forloop.index0 | times: 24 | plus: 274 %}
          {% if work.link != "" %}<a href="{{ work.link }}">{% endif %}
          <text class="research-svg-work" x="54" y="{{ work_y }}">
            <tspan class="research-svg-work-name">{{ work.name }}</tspan>{% if work.tag != "" %}<tspan> ({{ work.tag }})</tspan>{% endif %}
          </text>
          {% if work.link != "" %}</a>{% endif %}
        {% endfor %}
      </g>

      <g class="research-svg-class">
        <rect x="460" y="104" width="280" height="260" rx="4"></rect>
        <text class="research-svg-title" x="600" y="144">{{ synth_class.title }}</text>
        <text class="research-svg-body" x="484" y="174">
          {% for line in synth_class.summary_lines %}
            <tspan x="484" dy="{% if forloop.first %}0{% else %}20{% endif %}">{{ line }}</tspan>
          {% endfor %}
        </text>
        {% for work in synth_class.works %}
          {% assign work_y = forloop.index0 | times: 22 | plus: 260 %}
          {% if work.link != "" %}<a href="{{ work.link }}">{% endif %}
          <text class="research-svg-work" x="484" y="{{ work_y }}">
            <tspan class="research-svg-work-name">{{ work.name }}</tspan>{% if work.tag != "" %}<tspan> ({{ work.tag }})</tspan>{% endif %}
          </text>
          {% if work.link != "" %}</a>{% endif %}
        {% endfor %}
      </g>

      <g class="research-svg-class">
        <rect x="890" y="104" width="280" height="260" rx="4"></rect>
        <text class="research-svg-title" x="1030" y="144">{{ llm_class.title }}</text>
        <text class="research-svg-body" x="914" y="174">
          {% for line in llm_class.summary_lines %}
            <tspan x="914" dy="{% if forloop.first %}0{% else %}20{% endif %}">{{ line }}</tspan>
          {% endfor %}
        </text>
        {% for work in llm_class.works %}
          {% assign work_y = forloop.index0 | times: 22 | plus: 252 %}
          {% if work.link != "" %}<a href="{{ work.link }}">{% endif %}
          <text class="research-svg-work" x="914" y="{{ work_y }}">
            <tspan class="research-svg-work-name">{{ work.name }}</tspan>{% if work.tag != "" %}<tspan> ({{ work.tag }})</tspan>{% endif %}
          </text>
          {% if work.link != "" %}</a>{% endif %}
        {% endfor %}
      </g>

      <path class="research-svg-connector research-svg-blue-stroke" marker-end="url(#research-arrow-blue)" d="M170 104 L170 62 Q170 50 182 50 L508 50 Q520 50 520 62 L520 104"></path>
      <rect class="research-svg-label-bg" x="260" y="33" width="170" height="34" rx="4"></rect>
      <text class="research-svg-label research-svg-blue-text" x="345" y="47">
        {% for line in arch_to_synth.label_lines %}
          <tspan x="345" dy="{% if forloop.first %}0{% else %}14{% endif %}">{{ line }}</tspan>
        {% endfor %}
      </text>

      <path class="research-svg-connector research-svg-blue-stroke" marker-end="url(#research-arrow-blue)" d="M680 104 L680 62 Q680 50 692 50 L1018 50 Q1030 50 1030 62 L1030 104"></path>
      <rect class="research-svg-label-bg" x="770" y="33" width="170" height="34" rx="4"></rect>
      <text class="research-svg-label research-svg-blue-text" x="855" y="47">
        {% for line in synth_to_llm.label_lines %}
          <tspan x="855" dy="{% if forloop.first %}0{% else %}14{% endif %}">{{ line }}</tspan>
        {% endfor %}
      </text>

      <path class="research-svg-connector research-svg-green-stroke" marker-end="url(#research-arrow-green)" d="M545 364 L545 400 Q545 412 533 412 L242 412 Q230 412 230 400 L230 364"></path>
      <rect class="research-svg-label-bg" x="312" y="394" width="162" height="34" rx="4"></rect>
      <text class="research-svg-label research-svg-green-text" x="393" y="408">
        {% for line in synth_to_arch.label_lines %}
          <tspan x="393" dy="{% if forloop.first %}0{% else %}14{% endif %}">{{ line }}</tspan>
        {% endfor %}
      </text>

      <path class="research-svg-connector research-svg-green-stroke" marker-end="url(#research-arrow-green)" d="M975 364 L975 400 Q975 412 963 412 L672 412 Q660 412 660 400 L660 364"></path>
      <rect class="research-svg-label-bg" x="745" y="394" width="155" height="34" rx="4"></rect>
      <text class="research-svg-label research-svg-green-text" x="822" y="408">
        {% for line in llm_to_synth.label_lines %}
          <tspan x="822" dy="{% if forloop.first %}0{% else %}14{% endif %}">{{ line }}</tspan>
        {% endfor %}
      </text>

      <path class="research-svg-connector research-svg-green-stroke" marker-end="url(#research-arrow-green)" d="M1110 364 L1110 440 Q1110 452 1098 452 L102 452 Q90 452 90 440 L90 364"></path>
      <rect class="research-svg-label-bg" x="505" y="434" width="190" height="34" rx="4"></rect>
      <text class="research-svg-label research-svg-green-text" x="600" y="448">
        {% for line in llm_to_arch.label_lines %}
          <tspan x="600" dy="{% if forloop.first %}0{% else %}14{% endif %}">{{ line }}</tspan>
        {% endfor %}
      </text>
    </svg>
  </div>
</div>
