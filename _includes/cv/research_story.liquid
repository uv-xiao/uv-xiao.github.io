<div class="research-story">
  {% for paragraph in entry.contents.paragraphs %}
    <p>{{ paragraph }}</p>
  {% endfor %}

  <div class="research-diagram" aria-label="Research story diagram">
    <svg class="research-diagram-svg" viewBox="0 0 1200 640" role="img">
      <defs>
        <marker id="research-arrow-blue" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L8,4 L0,8 Z" class="research-svg-arrow-head research-svg-blue-fill"></path>
        </marker>
        <marker id="research-arrow-green" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L8,4 L0,8 Z" class="research-svg-arrow-head research-svg-green-fill"></path>
        </marker>
      </defs>

      <g class="research-svg-center">
        <rect x="250" y="28" width="700" height="78" rx="4"></rect>
        <text class="research-svg-title" x="600" y="58">
          {% for line in entry.contents.diagram.title_lines %}
            <tspan x="600" dy="{% if forloop.first %}0{% else %}24{% endif %}">{{ line }}</tspan>
          {% endfor %}
        </text>
      </g>

      {% for capability in entry.contents.diagram.capabilities %}
        {% case forloop.index0 %}
          {% when 0 %}
            {% assign cap_x = 60 %}
            {% assign cap_mid = 215 %}
          {% when 1 %}
            {% assign cap_x = 445 %}
            {% assign cap_mid = 600 %}
          {% when 2 %}
            {% assign cap_x = 830 %}
            {% assign cap_mid = 985 %}
        {% endcase %}
        <g class="research-svg-class">
          <rect x="{{ cap_x }}" y="150" width="310" height="150" rx="4"></rect>
          <path class="research-svg-connector research-svg-blue-stroke" marker-end="url(#research-arrow-blue)" d="M600 106 C600 124 {{ cap_mid }} 124 {{ cap_mid }} 150"></path>
          <text class="research-svg-title" x="{{ cap_mid }}" y="182">{{ capability.title }}</text>
          <text class="research-svg-body" x="{{ cap_x | plus: 24 }}" y="216">
            {% for line in capability.summary_lines %}
              <tspan x="{{ cap_x | plus: 24 }}" dy="{% if forloop.first %}0{% else %}20{% endif %}">{{ line }}</tspan>
            {% endfor %}
          </text>
        </g>
      {% endfor %}

      {% for outcome in entry.contents.diagram.outcomes %}
        {% if forloop.index0 == 0 %}
          {% assign out_x = 145 %}
          {% assign out_mid = 360 %}
        {% else %}
          {% assign out_x = 640 %}
          {% assign out_mid = 855 %}
        {% endif %}
        <g class="research-svg-outcome">
          <rect x="{{ out_x }}" y="360" width="420" height="92" rx="4"></rect>
          <text class="research-svg-title research-svg-green-text" x="{{ out_mid }}" y="392">{{ outcome.title }}</text>
          <text class="research-svg-body research-svg-green-text" x="{{ out_x | plus: 24 }}" y="424">
            {% for line in outcome.summary_lines %}
              <tspan x="{{ out_x | plus: 24 }}" dy="{% if forloop.first %}0{% else %}20{% endif %}">{{ line }}</tspan>
            {% endfor %}
          </text>
        </g>
      {% endfor %}

      <path class="research-svg-connector research-svg-green-stroke" marker-end="url(#research-arrow-green)" d="M215 300 C215 330 360 330 360 360"></path>
      <path class="research-svg-connector research-svg-green-stroke" marker-end="url(#research-arrow-green)" d="M600 300 C600 330 360 330 360 360"></path>
      <path class="research-svg-connector research-svg-green-stroke" marker-end="url(#research-arrow-green)" d="M600 300 C600 330 855 330 855 360"></path>
      <path class="research-svg-connector research-svg-green-stroke" marker-end="url(#research-arrow-green)" d="M985 300 C985 330 855 330 855 360"></path>

      <g class="research-svg-foundation">
        <rect x="50" y="500" width="1100" height="104" rx="4"></rect>
        <text class="research-svg-label research-svg-blue-text" x="600" y="526">{{ entry.contents.diagram.foundation_title }}</text>
        {% for foundation in entry.contents.diagram.foundations %}
          {% case forloop.index0 %}
            {% when 0 %}
              {% assign f_x = 80 %}
            {% when 1 %}
              {% assign f_x = 420 %}
            {% when 2 %}
              {% assign f_x = 760 %}
          {% endcase %}
          <text class="research-svg-foundation-title" x="{{ f_x }}" y="558">{{ foundation.title }}</text>
          <text class="research-svg-work" x="{{ f_x }}" y="582">
            {% for row in foundation.work_rows %}
              <tspan x="{{ f_x }}" dy="{% if forloop.first %}0{% else %}18{% endif %}">
              {% for work in row %}
                {% if work.link != "" %}
                  <a href="{{ work.link }}"><tspan class="research-svg-work-name">{{ work.name }}</tspan></a>
                {% else %}
                  <tspan class="research-svg-work-name">{{ work.name }}</tspan>
                {% endif %}
                {% unless forloop.last %}<tspan>, </tspan>{% endunless %}
              {% endfor %}
              </tspan>
            {% endfor %}
          </text>
        {% endfor %}
      </g>
    </svg>
  </div>
</div>
